{
  "functions": {
    "api/forge/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "server/forge/**"
    },
    "api/render-book-html.py": {
      "maxDuration": 300,
      "includeFiles": "{myphonics_books/scripts/generate_book.py,myphonics_books/scripts/generate_custom_book.py,myphonics_books/scripts/v2_helpers.py,myphonics_books/scripts/print_qr.py,myphonics_books/scripts/audit_tricky_words.py,myphonics_books/core/**,myphonics_books/templates/**,myphonics_books/assets/fonts/**,myphonics_books/data/**}",
      "excludeFiles": "{**/node_modules/**,.git/**,dist/**,public/**,src/**,marketing/**,worksheet-forge/**,worksheet-engine/**,server/worksheet-forge/**,myphonics_books/output/**,myphonics_books/_archive/**,myphonics_books/phonics-fun-hub/**}"
    }
  },
  "rewrites": [
    { "source": "/book-pdfs/:path*", "destination": "/book-pdfs/:path*" },
    { "source": "/covers/:path*", "destination": "/covers/:path*" },
    { "source": "/book-pages/:path*", "destination": "/book-pages/:path*" },
    { "source": "/illustrations/:path*", "destination": "/illustrations/:path*" },
    { "source": "/sounds/:path*", "destination": "/sounds/:path*" },
    { "source": "/images/:path*", "destination": "/images/:path*" },
    { "source": "/worksheets/:path*", "destination": "/worksheets/:path*" },
    { "source": "/api/forge/:path*", "destination": "/api/forge" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
